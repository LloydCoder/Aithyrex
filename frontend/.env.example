# Aithyrex Frontend — Environment Variables
# Copy to .env.local for local development. Production must use verified HTTPS endpoints.

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard

# API (local development only; set a verified HTTPS URL in production)
NEXT_PUBLIC_API_URL=http://localhost:8002
