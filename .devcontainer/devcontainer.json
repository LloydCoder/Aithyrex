{
  "name": "AI Shield",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "pip install -r backend/requirements.txt && echo '✅ AI Shield environment ready'",
  "forwardPorts": [8000, 3000, 5432, 6379],
  "portsAttributes": {
    "8000": { "label": "FastAPI Backend" },
    "3000": { "label": "Next.js Frontend" },
    "5432": { "label": "PostgreSQL" },
    "6379": { "label": "Redis" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.ruff",
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint",
        "eamodio.gitlens",
        "ms-python.mypy-type-checker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "ms-python.ruff"
        }
      }
    }
  }
}
