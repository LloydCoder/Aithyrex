# ── AI Shield Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Core ─────────────────────────────────────────────────────────────
APP_ENV=development                        # development | production
APP_SECRET_KEY=change-me-to-random-32-chars
LOG_LEVEL=INFO

# ── ThreatFade Bridge ─────────────────────────────────────────────────
# Running at: github.com/LloydCoder/tinlance-threatfade
THREATFADE_API_URL=http://localhost:8000
THREATFADE_API_KEY=your-threatfade-api-key

# ── LLM Providers (for analysis layer) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...               # Primary — Claude Sonnet
GROK_API_KEY=xai-...                       # Fallback — Grok-3
GEMINI_API_KEY=...                         # Emergency fallback

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aishield:password@localhost:5432/aishield
REDIS_URL=redis://localhost:6379/0

# ── Auth (Clerk) ──────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# ── Payments (LemonSqueezy) ───────────────────────────────────────────
LEMONSQUEEZY_API_KEY=...
LEMONSQUEEZY_STORE_ID=...
LEMONSQUEEZY_WEBHOOK_SECRET=...

# Product variant IDs
LEMONSQUEEZY_STARTER_VARIANT_ID=...
LEMONSQUEEZY_PRO_VARIANT_ID=...

# ── KalevioAI Integration (NIS2/DORA compliance) ─────────────────────
KALEVIOAI_API_URL=https://api.kalevioai.com
KALEVIOAI_API_KEY=...

# ── ReconOS OFE Integration (intelligence feed) ───────────────────────
RECONOS_API_URL=http://localhost:8001
RECONOS_API_KEY=...

# ── SIEM Export ───────────────────────────────────────────────────────
SPLUNK_HEC_URL=https://your-splunk:8088/services/collector
SPLUNK_HEC_TOKEN=...

# ── Alerts ───────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# ── Rate Limiting ─────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
FREE_TIER_MONTHLY_LIMIT=500
STARTER_TIER_MONTHLY_LIMIT=25000
PRO_TIER_MONTHLY_LIMIT=150000
